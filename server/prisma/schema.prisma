datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id           String        @id @default(uuid())
  email        String        @unique
  passwordHash String
  fullName     String
  role         String        @default("STUDENT") // STUDENT, ADMIN
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
  assessments  Assessment[]
  bookmarks    Bookmark[]
}

model Course {
  id              String        @id @default(uuid())
  name            String        @unique
  code            String        @unique
  description     String
  category        String
  difficulty      String        @default("Intermediate")
  duration        String        @default("6 Months")
  potentialSalary String        @default("$80,000 - $120,000")
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  traitWeights    CourseTraitWeight[]
  bookmarks       Bookmark[]
  recommendations Recommendation[]
}

model Trait {
  id           String              @id @default(uuid())
  name         String              @unique
  description  String?
  courseWeights CourseTraitWeight[]
  scores       TraitScore[]
}

model CourseTraitWeight {
  id       String @id @default(uuid())
  courseId String
  traitId  String
  weight   Float  // 0.0 to 10.0
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  trait    Trait  @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@unique([courseId, traitId])
}

model Question {
  id         String   @id @default(uuid())
  text       String
  type       String   // MULTIPLE_CHOICE, LIKERT, SCENARIO
  category   String
  orderIndex Int      @default(0)
  options    String   // Serialized JSON array of options
}

model Assessment {
  id             String               @id @default(uuid())
  userId         String
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status         String               @default("STARTED") // STARTED, COMPLETED
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  conversations  AIConversation[]
  responses      AssessmentResponse[]
  traitScores    TraitScore[]
  recommendations Recommendation[]
  careerReport   CareerReport?
  roadmap        Roadmap?
  progress       Progress[]
}

model AIConversation {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  role         String     // "assistant" | "user"
  text         String     // The question text or answer text
  options      String?    // Serialized JSON array of generated options if role is "assistant"
  type         String?    // MULTIPLE_CHOICE, LIKERT, SCENARIO
  createdAt    DateTime   @default(now())
}

model AssessmentResponse {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  questionText String
  answerText   String
  createdAt    DateTime   @default(now())
}

model TraitScore {
  id           String     @id @default(uuid())
  assessmentId String
  traitId      String
  score        Float      // 1.0 to 10.0
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  trait        Trait      @relation(fields: [traitId], references: [id], onDelete: Cascade)

  @@unique([assessmentId, traitId])
}

model Recommendation {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  courseId     String
  course       Course     @relation(fields: [courseId], references: [id], onDelete: Cascade)
  score        Float
  rank         Int

  @@unique([assessmentId, courseId])
}

model CareerReport {
  id                    String     @id @default(uuid())
  assessmentId          String     @unique
  assessment            Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  summary               String
  personalityInsights   String
  strengths             String     // Serialized JSON array of strings
  weaknesses            String     // Serialized JSON array of strings
  courseFitExplanations String     // Serialized JSON object mapping course names to reasons
  skillsToImprove       String     // Serialized JSON array of strings
  personalMotivation    String
  weeklyStudyPlan       String     // Serialized JSON array of study hours
  internshipStrategy    String
  resumeTips            String     // Serialized JSON array of resume suggestions
  interviewPrep         String     // Serialized JSON array of questions
  comparisonTop3        String
  createdAt             DateTime   @default(now())
}

model Roadmap {
  id           String     @id @default(uuid())
  assessmentId String     @unique
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  stages       String     // Serialized JSON array of stage objects
  createdAt    DateTime   @default(now())
}

model Progress {
  id           String     @id @default(uuid())
  assessmentId String
  assessment   Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  courseId     String
  stageName    String
  isCompleted  Boolean    @default(false)
  updatedAt    DateTime   @updatedAt

  @@unique([assessmentId, courseId, stageName])
}

model Bookmark {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  courseId  String
  course    Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, courseId])
}

model Resource {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  type        String   // YOUTUBE, BOOK, WEBSITE, CERTIFICATE
  url         String
  description String?
}
